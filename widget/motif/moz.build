EXPORTS += [
    'nsAppShell.h',
    'nsBidiKeyboard.h',
    'nsClipboard.h',
    'nsLookAndFeel.h',
    'nsMotifDisplay.h',
    'nsScreenManagerMotif.h',
    'nsScreenMotif.h',
    'nsWindow.h',
]

SOURCES += [
    'nsAppShell.cpp',
    'nsBidiKeyboard.cpp',
    'nsClipboard.cpp',
    'nsLookAndFeel.cpp',
    'nsMotifGlobals.cpp',
    'nsScreenManagerMotif.cpp',
    'nsScreenMotif.cpp',
    'nsWidgetFactory.cpp',
    'nsWindow.cpp',
]

include('/ipc/chromium/chromium-config.mozbuild')

FINAL_LIBRARY = 'xul'

LOCAL_INCLUDES += [
    '/layout/generic',
    '/layout/style',
    '/layout/xul',
    '/widget',
    '/widget/x11',
]

DEFINES['CAIRO_GFX'] = True
DEFINES['MOZ_X11'] = True

CFLAGS += CONFIG['TK_CFLAGS']
CXXFLAGS += CONFIG['TK_CFLAGS']
OS_LIBS += CONFIG['TK_LIBS']
