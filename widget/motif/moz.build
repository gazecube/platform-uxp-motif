# -*- Mode: python; indent-tabs-mode: nil; tab-width: 40 -*-
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at http://mozilla.org/MPL/2.0/.

EXPORTS += [
    'nsAppShell.h',
    'nsBidiKeyboard.h',
    'nsClipboard.h',
    'nsDragService.h',
    'nsLookAndFeel.h',
    'nsMotifDisplay.h',
    'nsScreenManagerMotif.h',
    'nsScreenMotif.h',
    'nsWindow.h',
]

EXPORTS.mozilla.widget += [
    'X11CompositorWidget.h',
]

SOURCES += [
    'nsAppShell.cpp',
    'nsBidiKeyboard.cpp',
    'nsClipboard.cpp',
    'nsDragService.cpp',
    'nsLookAndFeel.cpp',
    'nsMotifGlobals.cpp',
    'nsScreenManagerMotif.cpp',
    'nsScreenMotif.cpp',
    'nsWidgetFactory.cpp',
    'nsWindow.cpp',
    'WidgetTraceEvent.cpp',
]

include('/ipc/chromium/chromium-config.mozbuild')

FINAL_LIBRARY = 'xul'

LOCAL_INCLUDES += [
    '/layout/generic',
    '/layout/style',
    '/layout/xul',
    '/widget',
    '/widget/x11',
]

DEFINES['CAIRO_GFX'] = True
DEFINES['MOZ_X11'] = True

# Motif draws directly through Cairo/Xlib and therefore needs Cairo's
# public include flags just like the GTK widget backend does.
CFLAGS += CONFIG['MOZ_CAIRO_CFLAGS']
CXXFLAGS += CONFIG['MOZ_CAIRO_CFLAGS']

CFLAGS += CONFIG['TK_CFLAGS']
CXXFLAGS += CONFIG['TK_CFLAGS']

# Mozilla builds its own objects with hidden visibility.  Motif's public
# headers expose data symbols such as _XmStrings; keeping hidden visibility
# on references to those DSO-owned symbols makes gold require a local
# definition.  Limit the override to this backend's objects.
CXXFLAGS += ['-fvisibility=default']

# Unlike GTK/Pango, Motif does not pull the rest of the Unix graphics stack
# into libxul transitively.  Keep the toolkit libraries and add the direct
# dependencies used by the X11 shared-memory and Fontconfig/FreeType paths.
OS_LIBS += CONFIG['TK_LIBS']
OS_LIBS += [
    'fontconfig',
    'freetype',
    'X11-xcb',
    'xcb',
    'xcb-shm',
    'Xext',
]
